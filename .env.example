# Supabase project settings (Project Settings → API in the Supabase dashboard).
# Without these, the site still runs — the Remarks section just shows
# "Reviews aren't wired up yet" instead of the form.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, or it ships to the browser.
# Used only by /admin to read/moderate every remark (including unapproved
# ones and submitter emails), bypassing row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# /admin login. Pick your own values — never commit the real ones (this
# file is the only .env* file git tracks; see .gitignore).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string (e.g. `openssl rand -hex 32`) — signs the admin
# session cookie so it can't be forged.
ADMIN_SESSION_SECRET=
